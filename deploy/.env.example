# ================================================================
# MeshCore Bridge - Archivo de Configuración de Entorno (.env)
# Compatible con Heltec v3/v4, LilyGO T-Beam, RAK4631, Seeed, RP2040
# ================================================================

# Configuración Serial (Usa AUTO para detección automática o ruta explícita ej: /dev/ttyACM0 o COM3)
SERIAL_PORT=AUTO
BAUD_RATE=115200
SERIAL_TIMEOUT=30.0

# Broker Mosquitto MQTT
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60

# Prefijo de Tópicos MQTT (n8n se suscribe a: {TOPIC_PREFIX}/#)
TOPIC_PREFIX=meshcore

# Base de datos persistente SQLite Store & Forward
SQLITE_DB_PATH=meshcore_buffer.db

# Parámetros de Resiliencia y Control
TX_INTERVAL_SEC=1.0
OFFLINE_BUFFER_MAX_SIZE=1000
OFFLINE_BUFFER_TTL_HOURS=48.0
DEDUPLICATION_WINDOW_SEC=60.0
WATCHDOG_INTERVAL_SEC=60.0
HEALTH_METRICS_INTERVAL_SEC=60.0

# Parámetros de Radio y Airtime LoRa
LORA_DEFAULT_SF=11
LORA_DEFAULT_BW_KHZ=250.0
LORA_DEFAULT_CR=5
LORA_PREAMBLE_LEN=8

# Servidor Web SPA y API REST
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Servidor TCP Companion (App Móvil Oficial Android/iOS y CLI)
TCP_SERVER_ENABLED=true
TCP_SERVER_HOST=0.0.0.0
TCP_SERVER_PORT=5000

# Integración Home Assistant MQTT Auto-Discovery
HA_DISCOVERY_ENABLED=true
HA_TOPIC_PREFIX=homeassistant

# Registro (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
