    {
      "dot": "cyan",
      "title": "Ingreso y Framing Físico",
      "items": [
        "Recepción en radio LoRa SX1262 con demodulación por hardware",
        "Ingreso asíncrono a pyserial-asyncio con reconexión por watchdog",
        "Extracción HDLC delimitada por 0xAA / 0x55 con des-escape de bytes (0x1B)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Integridad y Deduplicación",
      "items": [
        "Cálculo estricto de CRC-16 para descartar tramas corruptas por RF",
        "Buffer circular de 10,000 hashes para deduplicar ecos y retransmisiones",
        "Clasificación canónica por OpCode y AdvertType oficial"
      ]
    },
    {
      "dot": "rose",
      "title": "Distribución IP Concurrente",
      "items": [
        "Actualización atómica de telemetría y tabla de vecinos en SQLite",
        "Difusión instantánea a todos los clientes web conectados vía WebSockets",
        "Publicación estructurada JSON a tópicos MQTT para flujos n8n"
