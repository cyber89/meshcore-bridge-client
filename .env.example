# ================================================================
# MeshCore Universal Bridge & Web Station v3.0
# Archivo de Configuración de Entorno (.env)
# Compatible con Heltec (v2/v3/v4), LilyGO T-Beam/T-Echo, RAK4631, Seeed, RP2040
# ================================================================

# ----------------------------------------------------------------
# 1. Conexión Serial / Hardware LoRa
# ----------------------------------------------------------------
# Puerto serial: usa /dev/ttyACM0, /dev/ttyUSB0, COM3, o AUTO para autodetección
SERIAL_PORT=AUTO
BAUD_RATE=115200
SERIAL_TIMEOUT=30.0

# ----------------------------------------------------------------
# 2. Broker MQTT (Mosquitto / n8n / Home Assistant)
# ----------------------------------------------------------------
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60
MQTT_MAX_PAYLOAD_BYTES=131072

# Prefijo de Tópicos MQTT (n8n / suscriptores escuchan: {TOPIC_PREFIX}/#)
TOPIC_PREFIX=meshcore

# ----------------------------------------------------------------
# 3. Servidor Web Integrado, API REST y WebSockets
# ----------------------------------------------------------------
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Clave secreta para proteger endpoints administrativos y transmisión TX por REST/WS
# Deja vacía para modo desarrollo local abierto sin autenticación
BRIDGE_API_KEY=

# Orígenes CORS permitidos (separados por coma). Same-Origin y subredes LAN se autorizan automáticamente
BRIDGE_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Tiempo máximo de inactividad WebSocket antes de verificar vivacidad con ping (segundos)
WS_IDLE_TIMEOUT_SEC=30.0

# ----------------------------------------------------------------
# 4. Servidor TCP Companion (App Móvil Oficial Android/iOS y CLI)
# ----------------------------------------------------------------
TCP_SERVER_ENABLED=true
TCP_SERVER_HOST=0.0.0.0
TCP_SERVER_PORT=5000
MAX_COMPANION_CLIENTS=8
COMPANION_ALLOWED_IPS=
COMPANION_TOKEN=

# ----------------------------------------------------------------
# 5. Parámetros de Radio y Airtime LoRa
# ----------------------------------------------------------------
# Spreading Factor por defecto (SF7 a SF12)
LORA_DEFAULT_SF=11
# Ancho de banda en kHz (125.0, 250.0 o 500.0)
LORA_DEFAULT_BW_KHZ=250.0
# Coding Rate (5 = 4/5, 6 = 4/6, etc.)
LORA_DEFAULT_CR=5
# Símbolos de preámbulo
LORA_PREAMBLE_LEN=8

# ----------------------------------------------------------------
# 6. Resiliencia, Concurrencia y Control de Flujo
# ----------------------------------------------------------------
# Espaciado mínimo de transmisión RF entre paquetes (segundos)
TX_INTERVAL_SEC=1.0
# Tamaño máximo de la cola asíncrona de transmisión TX antes de descartar con backpressure
MAX_TX_QUEUE_SIZE=500
# Concurrencia máxima simultánea de procesamiento de eventos RX
MAX_RX_CONCURRENCY=20
# Ventana temporal en RAM para deduplicación instantánea de ecos y duplicados RF (segundos)
DEDUPLICATION_WINDOW_SEC=60.0
# Intervalo de supervisión y comprobación de vivacidad del puerto serial (segundos)
WATCHDOG_INTERVAL_SEC=60.0
# Intervalo de publicación de métricas de salud en meshcore/bridge/health (segundos)
HEALTH_METRICS_INTERVAL_SEC=60.0
# Intentos máximos de reconexión serial (0 = reintentos infinitos)
MAX_RECONNECT_ATTEMPTS=0

# ----------------------------------------------------------------
# 7. Persistencia de Datos y Directorio de Nodos
# ----------------------------------------------------------------
SQLITE_DB_PATH=data/meshcore_buffer.db
NODE_REGISTRY_STORAGE_PATH=data/node_registry.json

# ----------------------------------------------------------------
# 8. Registro y Logs (DEBUG, INFO, WARNING, ERROR)
# ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
