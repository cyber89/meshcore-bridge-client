# ================================================================
# Configuración del Puente MeshCore <-> MQTT Bridge
# ================================================================

# Configuración del Puerto Serial (Heltec / LilyGO / RAKwireless / Seeed / RP2040)
SERIAL_PORT=/dev/ttyACM0
BAUD_RATE=115200
SERIAL_TIMEOUT=30.0

# Configuración del Broker MQTT (Mosquitto)
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60

# Prefijo de Tópicos MQTT
TOPIC_PREFIX=meshcore

# Parámetros de Resiliencia y Control de Tráfico
SQLITE_DB_PATH=meshcore_buffer.db    # Ruta a la base de datos SQLite para buffer offline persistente
TX_INTERVAL_SEC=1.0                  # Espaciado mínimo entre paquetes TX (LoRa Rate Limiter)
OFFLINE_BUFFER_MAX_SIZE=1000         # Cantidad máxima de mensajes RX retenidos en SQLite si MQTT se cae
WATCHDOG_INTERVAL_SEC=60.0           # Intervalo en segundos para verificar vivacidad serial
HEALTH_METRICS_INTERVAL_SEC=60.0     # Frecuencia de publicación de métricas de salud

# Nivel de Registro (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
