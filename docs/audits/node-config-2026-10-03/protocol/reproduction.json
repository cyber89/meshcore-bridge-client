    },
    {
      "action": "set_advert_interval",
      "params": {
        "advert_interval": 0
      },
      "command": "set advert.interval 2"
    },
    {
      "action": "set_advert_interval",
      "params": {
        "advert_interval": 300
      },
      "command": "set advert.interval 5"
    },
    {
      "action": "set_advert_interval",
      "params": {
