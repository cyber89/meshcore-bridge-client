[Unit]
Description=MeshCore Universal Bridge & Web Station v3.0 Service
After=network.target

[Service]
Type=simple
User=meshcore
Group=meshcore
WorkingDirectory=/opt/meshcore-bridge
ExecStart=/opt/meshcore-bridge/venv/bin/python /opt/meshcore-bridge/meshcore_bridge.py
Restart=always
RestartSec=5
EnvironmentFile=-/opt/meshcore-bridge/.env
StandardOutput=journal
StandardError=journal

# Service account created by install.sh; requires serial and data permissions.
NoNewPrivileges=true
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
